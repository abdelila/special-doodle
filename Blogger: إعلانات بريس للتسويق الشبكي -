.CSS_LIGHTBOX_TOOLBAR_SEPARATOR { color: rgb(204, 204, 204); line-height: 20px; }

.CSS_LIGHTBOX_TOOLBAR_LEFT { float: left; }

.CSS_LIGHTBOX_TOOLBAR_RIGHT { float: right; }

.CSS_LIGHTBOX_TOOLBAR .goog-imageless-button { font-size: 1.08em; outline: none; vertical-align: middle; }

.CSS_LIGHTBOX_TOOLBAR .goog-imageless-button-outer-box { border: none; }

.CSS_LIGHTBOX_TOOLBAR .goog-imageless-button-content { color: rgb(204, 204, 204); line-height: 1.55em; padding: 0px 8px; }

