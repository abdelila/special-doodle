.CSS_LIGHTBOX_TOOLBAR .goog-imageless-button-top-shadow { background: inherit; border: none; height: 0.8em; position: absolute; }

.CSS_LIGHTBOX_TOOLBAR_CLOSE_BUTTON_ICON { color: rgb(238, 238, 238); margin-right: 6px; }

