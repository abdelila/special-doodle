.CSS_LIGHTBOX_TOOLBAR_BUTTON_MENU .goog-menuitem-highlight { background-color: rgb(51, 51, 51); border: 0px; cursor: pointer; }

.CSS_LIGHTBOX_TOOLBAR_BUTTON_MENU .goog-menuitem-content { font-size: 0.84em; line-height: 1em; white-space: nowrap; background-color: transparent !important; color: rgb(204, 204, 204) !important; }

