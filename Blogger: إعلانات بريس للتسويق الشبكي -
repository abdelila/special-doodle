body#layout .add_widget { border: 1px dashed rgb(204, 204, 204); padding: 16px; position: relative; text-align: left; }

body#layout .add_widget a { color: rgb(33, 150, 243); display: block; font-size: 16px; line-height: 24px; margin-left: 40px; text-decoration: none; }

body#layout .section-columns .add_widget a { margin-left: 32px; }

body#layout .add_widget a::before { }

body#layout a:visited { color: rgb(17, 85, 204); }

body#layout a:hover { text-decoration: underline; }

body#layout div.layout-title { font-size: 16px; }

body#layout div.layout-widget-description { color: rgba(0, 0, 0, 0.52); font-size: 14px; }

body#layout div.layout-widget-status { font-size: 11px; }

body#layout .visible { color: rgb(0, 184, 0); }

body#layout .not-visible { color: rgb(184, 0, 0); }

body#layout .editlink { bottom: 8px; cursor: pointer; margin: 0px; padding: 0px; position: absolute; right: 10px; text-decoration: underline; color: rgb(127, 154, 204) !important; }

body#layout .dropregion { font-size: 1px; line-height: 0; height: 0px; margin: 0px 4px; position: relative; }

body#layout .el_active { z-index: 10; }

body#layout .dr_active { border: 1px dashed rgb(212, 225, 255); background-color: rgb(255, 255, 255); margin: 0px 4px 3px; }

body#layout #header-wrapper { min-height: 0px; }

body#layout .columns { overflow: visible; }

body#layout .header-outer, body#layout .tabs-outer, body#layout .main-outer, body#layout .footer-outer { margin: 0px; }

body#layout .header-inner, body#layout .tabs-inner, body#layout .main-inner, body#layout .footer-inner { overflow: visible; }

body#layout .main-inner .column-center-outer .column-center-inner, body#layout .main-inner .column-left-outer .column-left-inner, body#layout .main-inner .column-right-outer .column-right-inner { padding-left: 0px; padding-right: 0px; }

#layout .content-outer, #layout .content-fauxcolumn-outer, #layout .region-inner { max-width: 800px; min-width: 0px; width: auto; }

body#layout .content-inner { padding: 0px 10px 10px; }

body#layout .clearfix { }

body#layout .clearfix::before, body#layout .clearfix::after { content: ""; display: table; line-height: 0; }

body#layout .clearfix::after { clear: both; }

body#layout .page-container { padding: 0px; }

body#layout .page-container .section.main { float: left; width: 55%; }

body#layout .page-container aside { float: right; width: 31.62%; }

body#layout .section h4 { font-size: 16px; line-height: 24px; margin: 2px 24px 8px; text-align: left; }

body#layout .section-columns .section h4 { margin: 2px 12px 8px; }

